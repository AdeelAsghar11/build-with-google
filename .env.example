# Gemini API Key (paid tier or credits linked GCP project)
GEMINI_API_KEY=

# Grading Mode: per_criterion (default) | per_submission (fallback if rate-limited)
GRADING_MODE=per_criterion

# LLM Concurrency limit
LLM_CONCURRENCY=6

# LLM Cache: on | off
LLM_CACHE=on

# Model IDs (verified via scripts/ping-models.ts)
MODEL_GRADER_A=gemini-2.5-flash
MODEL_GRADER_B=gemini-2.5-flash-lite
MODEL_ARBITER=gemini-2.5-pro
MODEL_COMPILER=gemini-2.5-pro
MODEL_FEEDBACK=gemini-2.5-flash
MODEL_GUARD=gemma-3-27b-it
MODEL_GUARD_FALLBACK=gemini-2.5-flash-lite
MODEL_EMBED=gemini-embedding-001

# Auth Mode: firebase | demo
AUTH_MODE=demo

# Firebase Admin SDK (Server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Application URL
APP_BASE_URL=http://localhost:3000
